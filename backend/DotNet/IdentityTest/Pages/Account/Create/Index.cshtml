@page
@using ClassLibrary
@model IdentityTest.Pages.Account.Create.IndexModel
@{

}

<div>
    <partial name="_ValidationSummary" />

    <div class="row">
        <div class="col-sm-12 col-lg-6 offset-lg-3">
            <div class="card">
                <div class="card-header">
                    <h2>Create</h2>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert" onclick="this.style.display='none'">
                            @TempData["SuccessMessage"]
                        </div>
                    }
                    <form method="post">
                        @* <input type="hidden" asp-for="Input.ReturnUrl" /> *@
                        <div class="form-group">
                            <label asp-for="Input.Phone"></label>
                            <input class="form-control" placeholder="phone" asp-for="Input.Phone" autofocus />
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.Name"></label>
                            <input class="form-control" placeholder="name" asp-for="Input.Name" />
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.Password"></label>
                            <input type="password" class="form-control" placeholder="password" asp-for="Input.Password" />
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.UserRole"></label>
                            <select asp-for="Input.UserRole" class="form-control">
                                <option value="@UserRole.CLIENT">Клиент</option>
                                <option value="@UserRole.EMPLOYEE">Сотрудник и клиент</option>
                            </select>
                        </div>

                        <button class="btn btn-primary" name="button" value="Register">Register</button>
                    </form>
                </div>
@*                 <div class="card-footer">
                    <a asp-page="../Login/Index" asp-route-returnUrl="@Model.Input.ReturnUrl">Login</a>
                </div> *@
            </div>
        </div>
    </div>
</div>