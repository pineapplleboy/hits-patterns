<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="014-add-currency-id-to-accounts" author="aleksey.z">
        <addColumn tableName="bank_account">
            <column name="currency_id" type="INT" defaultValueNumeric="643">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <update tableName="bank_account">
            <column name="currency_id" valueNumeric="643"/>
        </update>

        <addColumn tableName="credit_account">
            <column name="currency_id" type="INT" defaultValueNumeric="643">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <update tableName="credit_account">
            <column name="currency_id" valueNumeric="643"/>
        </update>
    </changeSet>

</databaseChangeLog>
