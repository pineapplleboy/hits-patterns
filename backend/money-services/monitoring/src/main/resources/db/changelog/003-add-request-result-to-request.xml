<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="003-add-request-result-to-request" author="aleksey.z">
        <addColumn tableName="request">
            <column name="request_result" type="VARCHAR(32)" defaultValue="OK">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <createIndex tableName="request" indexName="idx_request_request_result">
            <column name="request_result"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
