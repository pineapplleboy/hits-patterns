<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="004-rename-log-authorization-column" author="codex">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="log" columnName="authorization"/>
        </preConditions>

        <renameColumn tableName="log"
                      oldColumnName="authorization"
                      newColumnName="authorization_header"
                      columnDataType="TEXT"/>
    </changeSet>

</databaseChangeLog>
