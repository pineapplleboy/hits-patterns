<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="001-create-push-device" author="aleksey.z">
        <createTable tableName="push_device">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="user_role" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <column name="fcm_token" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>

            <column name="active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()"/>

            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()"/>
        </createTable>

        <addUniqueConstraint
                tableName="push_device"
                columnNames="fcm_token"
                constraintName="uq_push_device_fcm_token"/>

        <createIndex tableName="push_device" indexName="idx_push_device_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
